# ===================================================
# DROPICK Frontend Environment Variables
# ===================================================
# 실제 연동 시 이 파일을 복사하여 .env 파일로 저장하세요
# cp .env.example .env

# ---------------------------------------------------
# API Mode
# true: LocalStorage Mock (개발/발표용)
# false: Spring Boot REST API 실제 연동
# ---------------------------------------------------
VITE_USE_MOCK_API=false

# ---------------------------------------------------
# Spring Boot API Base URL
# ---------------------------------------------------
VITE_API_BASE_URL=https://capstone-production-b50e.up.railway.app/api
# 로컬 개발 시:
# VITE_API_BASE_URL=http://localhost:8080/api

# ---------------------------------------------------
# 토스페이먼츠 Client Key
# 발급: https://developers.tosspayments.com
# 테스트: test_ck_ 로 시작하는 키
# 운영: live_ck_ 로 시작하는 키
# ---------------------------------------------------
VITE_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq

# ---------------------------------------------------
# 아래 시크릿 키는 절대 프론트엔드에 넣지 마세요!
# Spring Boot application.yml에만 설정합니다.
# ---------------------------------------------------
# TOSS_SECRET_KEY=test_sk_여기에_시크릿키 (Spring Boot 전용)
